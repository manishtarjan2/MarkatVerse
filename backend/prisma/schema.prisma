datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String?  @unique
  phone     String?  @unique
  password  String
  name      String
  role      String   @default("CONSUMER") // CONSUMER, SELLER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business?
  products    Product[]
  orders      Order[]
  buyerLeads  Lead[]    @relation("BuyerLeads")
  sellerLeads Lead[]    @relation("SellerLeads")
  salonQueue  SalonQueue?

  // V2 Relations
  listings    Listing[] @relation("UserListings")
}

model Business {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String  @unique @db.ObjectId
  name         String
  logo         String?
  description  String?
  businessType String // MANUFACTURER, WHOLESALER, etc
  address      String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Category {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  parentId  String?    @db.ObjectId
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryToCategory")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]
  
  // V2 Relations
  sectorId String?   @db.ObjectId
  sector   Sector?   @relation("SectorToCategory", fields: [sectorId], references: [id])
  listings Listing[] @relation("CategoryToListing")
}

model Product {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  sellerId      String?  @db.ObjectId
  categoryId    String?  @db.ObjectId

  // Frontend fields
  name          String
  description   String?
  price         Float
  originalPrice Float?
  discount      String?
  rating        String?  @default("0.0")
  reviews       String?  @default("0")
  sellerName    String?
  location      String?
  categoryName  String?
  subcategory   String?
  parameters    Json?
  badge         String?
  badgeColor    String?
  image         String?
  images        String[] @default([])

  stock         Int      @default(0)
  sku           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  isB2B         Boolean  @default(false)
  moq           Int?     @default(1)

  seller     User?       @relation(fields: [sellerId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  leads      Lead[]
}

model Lead {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerId           String   @db.ObjectId
  sellerId          String   @db.ObjectId
  productId         String   @db.ObjectId
  message           String
  quantityRequested Int
  status            String   @default("PENDING") // PENDING, REPLIED, CLOSED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  buyer   User    @relation("BuyerLeads", fields: [buyerId], references: [id])
  seller  User    @relation("SellerLeads", fields: [sellerId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  buyerId   String      @db.ObjectId
  total     Float
  status    String      @default("PENDING") // PENDING, SHIPPED, etc
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyer User        @relation(fields: [buyerId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model SalonQueue {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  shopName     String
  sellerId     String?      @unique @db.ObjectId
  currentToken Int          @default(0)
  lastToken    Int          @default(0)
  avgMinutes   Int          @default(20)
  pricePerHour Float        @default(0)
  isOpen       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tokens SalonToken[]
  seller User?        @relation(fields: [sellerId], references: [id])
}

model SalonToken {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  queueId      String    @db.ObjectId
  tokenNumber  Int
  customerName String
  phone        String?
  service      String    @default("Haircut")
  status       String    @default("WAITING") // WAITING, SERVING, DONE, NO_SHOW
  joinedAt     DateTime  @default(now())
  servedAt     DateTime?
  doneAt       DateTime?

  queue SalonQueue @relation(fields: [queueId], references: [id])
}

// ---------------------------------------------------------
// V2 CONFIGURATION-DRIVEN ARCHITECTURE MODELS
// ---------------------------------------------------------

enum MainType {
  B2B
  B2C
  BOTH
  SERVICE
}

model BusinessType {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  mainType    MainType
  name        String    // e.g. Manufacturer, Wholesaler, Shop, Professional
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sectors     Sector[]
  listings    Listing[]
}

model Sector {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  businessTypeId String       @db.ObjectId
  name           String       // e.g. Electronics, Salon, Healthcare
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  businessType   BusinessType @relation(fields: [businessTypeId], references: [id])
  categories     Category[]   @relation("SectorToCategory")
  listings       Listing[]
}

